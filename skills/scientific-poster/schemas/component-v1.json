{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific-poster.component.v1",
  "type": "object",
  "required": ["schema", "id", "version", "level", "purpose", "semantic_roles"],
  "properties": {
    "schema": {"const": "scientific-poster.component.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "level": {"enum": ["atom", "composite"]},
    "purpose": {"type": "string", "minLength": 20, "maxLength": 500},
    "semantic_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    }
  },
  "additionalProperties": false
}
