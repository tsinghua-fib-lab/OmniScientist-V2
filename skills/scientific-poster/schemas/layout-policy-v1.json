{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scientific-poster.layout-policy.v1",
  "type": "object",
  "required": ["schema", "id", "version", "purpose", "page_modes", "strategies"],
  "properties": {
    "schema": {"const": "scientific-poster.layout-policy.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "purpose": {"type": "string", "minLength": 20, "maxLength": 500},
    "page_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["portrait", "landscape"]}},
    "strategies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}
  },
  "additionalProperties": false
}
