{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientist-kg.local/kg.schema.json",
  "title": "Scientist Personality Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "L3_stances", "L2_patterns", "L1_facts", "edges"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientist_id",
        "scientist_name",
        "kg_version",
        "schema_version",
        "total_L1",
        "total_L2",
        "total_L3",
        "review_status"
      ],
      "properties": {
        "scientist_id": {"type": "string", "minLength": 1},
        "scientist_name": {"type": "string", "minLength": 1},
        "kg_version": {"const": "1.0"},
        "schema_version": {"const": "1.1.0"},
        "total_L1": {"type": "integer", "minimum": 0},
        "total_L2": {"const": 7},
        "total_L3": {"const": 4},
        "review_status": {
          "type": "object",
          "required": ["L1_L2", "L3", "L2_edges"],
          "properties": {
            "L1_L2": {"type": "string"},
            "L3": {"type": "string"},
            "L2_edges": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    },
    "L3_stances": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/l3Node"}
    },
    "L2_patterns": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/l2"}
    },
    "L1_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/l1"}
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summarizes", "supports", "reinforces", "enables", "tension"],
      "properties": {
        "summarizes": {
          "type": "array",
          "items": {"$ref": "#/$defs/directedEdge"}
        },
        "supports": {
          "type": "array",
          "items": {"$ref": "#/$defs/directedEdge"}
        },
        "reinforces": {
          "type": "array",
          "items": {"$ref": "#/$defs/reasonedEdge"}
        },
        "enables": {
          "type": "array",
          "items": {"$ref": "#/$defs/reasonedEdge"}
        },
        "tension": {
          "type": "array",
          "items": {"$ref": "#/$defs/tensionEdge"}
        }
      }
    }
  },
  "$defs": {
    "l1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "level",
        "source_id",
        "source_title",
        "source_type",
        "year",
        "quote_or_excerpt",
        "location",
        "observation",
        "fact_type",
        "author_role",
        "parent_L2"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^l1_"},
        "level": {"const": "L1"},
        "source_id": {"type": "string"},
        "source_title": {"type": "string"},
        "source_type": {"type": "string"},
        "year": {"type": ["integer", "null"]},
        "quote_or_excerpt": {"type": "string", "minLength": 1},
        "location": {"type": "object"},
        "observation": {"type": "string", "minLength": 1},
        "fact_type": {"type": "string"},
        "author_role": {"type": "string"},
        "parent_L2": {"type": "string", "pattern": "^l2_"}
      }
    },
    "l2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "level",
        "category",
        "category_label",
        "description",
        "trigger_contexts",
        "contraindicated_contexts",
        "supporting_L1_count"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^l2_.+_C0[1-7]$"},
        "level": {"const": "L2"},
        "category": {"enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07"]},
        "category_label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "trigger_contexts": {"type": "array", "items": {"type": "string"}},
        "contraindicated_contexts": {"type": "array", "items": {"type": "string"}},
        "supporting_L1_count": {"type": "integer", "minimum": 0}
      }
    },
    "l3Node": {
      "oneOf": [
        {"$ref": "#/$defs/l3Stance"},
        {"$ref": "#/$defs/l3Tone"}
      ]
    },
    "l3Stance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "level",
        "question",
        "question_label",
        "stance",
        "explanation",
        "considered_L2",
        "summarized_from_L2",
        "exemplar_L1",
        "value_dimensions",
        "identity_context",
        "human_review_required"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^l3_.+_P0[1-3]$"},
        "level": {"const": "L3"},
        "question": {"enum": ["P01", "P02", "P03"]},
        "question_label": {"type": "string", "minLength": 1},
        "stance": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "considered_L2": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"type": "string", "pattern": "^l2_"}
        },
        "summarized_from_L2": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^l2_"}
        },
        "exemplar_L1": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^l1_"}},
        "value_dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relative_priority", "explanation"],
            "properties": {
              "name": {"type": "string"},
              "relative_priority": {"type": "string", "minLength": 1},
              "explanation": {"type": "string", "minLength": 1}
            }
          }
        },
        "identity_context": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "scientist_name",
            "aliases",
            "occupations",
            "research_fields",
            "education_history",
            "employment_history",
            "institutions",
            "sources"
          ],
          "properties": {
            "scientist_name": {"type": "string"},
            "aliases": {"type": "array", "items": {"type": "string"}},
            "occupations": {"type": "array", "items": {"type": "string"}},
            "research_fields": {"type": "array", "items": {"type": "string"}},
            "education_history": {"type": "array", "items": {"type": "object"}},
            "employment_history": {"type": "array", "items": {"type": "object"}},
            "institutions": {"type": "array", "items": {"type": "string"}},
            "sources": {"type": "array", "items": {"type": "string"}},
            "google_scholar_url": {"type": "string"},
            "portrait_url": {"type": "string"},
            "portrait_source_url": {"type": "string"}
          }
        },
        "human_review_required": {"const": false}
      }
    },
    "l3Tone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "level",
        "question",
        "question_label",
        "tone_exemplars"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^l3_.+_P04$"},
        "level": {"const": "L3"},
        "question": {"const": "P04"},
        "question_label": {"const": "语气"},
        "tone_exemplars": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "directedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"}
      }
    },
    "reasonedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "tensionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["between", "context", "reason"],
      "properties": {
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "pattern": "^l2_"}
        },
        "context": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      }
    }
  }
}
